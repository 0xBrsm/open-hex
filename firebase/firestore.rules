rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public reads for leaderboard, game history, etc.
    match /bots/{botId} {
      allow read: if true;
      allow write: if false;
    }
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }
    match /games/{gameId}/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /games/{gameId}/actionLog/{logId} {
      allow read: if true;
      allow write: if false;
    }
    match /queue/{queueId} {
      allow read: if true;
      allow write: if false;
    }
    match /head-to-head/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // API keys are private — only Cloud Functions (admin SDK) can read
    match /apiKeys/{key} {
      allow read: if false;
      allow write: if false;
    }
  }
}
